  "critical_issues": [
    {
      "id": "TIMER_001",
      "title": "Session Timer Always Shows 00:00",
      "severity": "CRITICAL",
      "component": "frontend/user-ui/src/components/AppShell.tsx",
      "line_numbers": [24, 37],
      "description": "Global exam timer initializes once on mount but never updates during exam. Users see frozen '00:00' throughout 60-minute test.",
      "root_cause": "useEffect dependency array incomplete. Missing sessionId/session updates.",
      "impact": "Auto-submission logic never triggers. Users cannot see time remaining.",
      "user_experience": "Negative — Timer appears broken, creates anxiety",
      "estimated_fix_time_hours": 1,
      "fix_complexity": "Low",
      "fix_code_example": "Add proper dependency tracking and interval that doesn't recreate every second",
      "blocked_features": [
        "Auto-submit when time expires",
        "User time awareness during exam",
        "Accurate session duration enforcement"
      ],
      "status": "Identified",
      "priority": "BLOCKER"
    }
  ],

  "high_priority_issues": [
    {
      "id": "PDF_CHART_001",
      "title": "PDF Report Charts Not Professional Quality",
      "severity": "HIGH",
      "component": "backend/PsyApi/Services/Reports/BarChartRenderer.cs",
      "description": "Vertical bar layout, single color (blue), small fonts. Difficult to read and doesn't convey performance bands.",
      "current_state": "Vertical bars, unsorted, 9-12pt fonts",
      "recommended_state": "Horizontal bars, ascending T-score order, color-banded (Red/Orange/Green), 12-14pt fonts",
      "affected_users": "All report recipients",
      "impact": "Professional credibility reduced",
      "estimated_fix_time_hours": 2,
      "fix_complexity": "Low",
      "issues_list": [
        "Vertical orientation reduces readability",
        "Single color doesn't indicate performance tiers",
        "Font sizes too small for print",
        "No ascending order (confusing sort)",
        "No legend for color bands"
      ],
      "recommendation": "Use horizontal bar layout with color bands: <40 Red, 40-54.9 Orange, ≥55 Green",
      "status": "Identified",
      "priority": "HIGH"
    },
    {
      "id": "DESIGN_001",
      "title": "Inconsistent Color Palette Across UIs",
      "severity": "HIGH",
      "components": ["frontend/src/", "frontend/admin-ui/src/"],
      "description": "User UI uses hard-coded Indigo/Blue gradients. Admin UI uses HSL CSS variables. No unified design system.",
      "user_impact": "Switching between UIs feels disjointed",
      "brand_impact": "Inconsistent brand perception",
      "estimated_fix_time_hours": 16,
      "fix_complexity": "Medium",
      "issues_list": [
        "User UI: Hard-coded colors scattered throughout components",
        "Admin UI: 12+ color variables via CSS; hard to track",
        "No semantic naming (success vs. positive vs. good)",
        "Weak contrast in some combinations",
        "Colors not aligned with accessibility standards"
      ],
      "recommendation": "Implement unified 3-color + 2-accent + neutral system with Tailwind tokens",
      "status": "Identified",
      "priority": "HIGH"
    },
    {
      "id": "PERF_001",
      "title": "Large Bundle Size — Admin UI ~1.1MB Gzipped",
      "severity": "HIGH",
      "component": "frontend/admin-ui/",
      "description": "Heavy dependencies (ApexCharts 200KB, Radix UI 150KB, Framer Motion 100KB) increase load time.",
      "metrics": {
        "gzipped_size_mb": 1.1,
        "load_time_3g_seconds": 8.5,
        "largest_dependencies": [
          "apexcharts@4.2.0 (200KB)",
          "radix-ui/* (150KB total)",
          "framer-motion@11.0.3 (100KB)",
          "react@18.3.1 (42KB)"
        ]
      },
      "estimated_fix_time_hours": 8,
      "fix_complexity": "Medium",
      "recommendations": [
        "Replace ApexCharts with ECharts (lighter, ~50KB)",
        "Add route-based code splitting (lazy load charts)",
        "Remove unused animations (CSS fallbacks)",
        "Enable tree-shaking for Radix UI imports"
      ],
      "potential_reduction": "300-400KB (30-35%)",
      "status": "Identified",
      "priority": "HIGH"
    }
  ],

