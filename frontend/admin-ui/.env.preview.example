# Admin UI - Vercel Preview Environment Configuration
# Copy this to .env.production for Vercel deployment

# Backend API Base URL (update with your Render backend URL after deployment)
VITE_API_BASE=https://psy-api-backend.onrender.com/api

# Demo Mode (set to false for production with real backend)
VITE_DEMO_MODE=false

# Optional: OpenAI Key for client-side recommendations (not recommended - use backend instead)
# VITE_OPENAI_KEY=sk-xxxxx

# DEPLOYMENT INSTRUCTIONS:
# 1. Deploy backend to Render first
# 2. Copy your Render backend URL (e.g., https://psy-api-backend.onrender.com)
# 3. Update VITE_API_BASE above with "/api" suffix
# 4. In Vercel dashboard, set this as environment variable
# 5. Deploy frontend to Vercel
# 6. Test admin login and analytics dashboard
