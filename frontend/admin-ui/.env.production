# Production Mode Configuration
# Set VITE_DEMO_MODE=false to disable demo mode and use real backend
VITE_DEMO_MODE=false

# API Base URL for production backend
VITE_API_BASE=https://psy-api-backend.onrender.com/api

# App environment
VITE_APP_ENV=prod

# Optional: Strict contract validation (recommended for production)
VITE_STRICT_CONTRACTS=true