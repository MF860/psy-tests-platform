# Demo Mode Configuration for Admin UI
# Set VITE_DEMO_MODE=true to enable full demo mode with client-side mocks
VITE_DEMO_MODE=true

# API Base URL (ignored when demo mode is enabled)
VITE_API_BASE=http://localhost:5019/api

# Optional: OpenAI API Key for real AI analysis even in demo mode
# If not provided, mock recommendations will be used
# VITE_OPENAI_KEY=your_openai_key_here